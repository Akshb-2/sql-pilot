-- ------------------------------------------- Customer --------------------------------------------
-- How many unique customer types does the data have?
SELECT count(distinct (Customer_type)) type_cnt
from walmart_sales;

-- How many unique payment methods does the data have?
SELECT count(distinct (payment)) type_cnt
from walmart_sales;

-- What is the most common customer type?
SELECT Customer_type, count(Invoice_id) cnt
FROM walmart_sales
GROUP BY Customer_type
ORDER BY cnt desc
;

-- What is the gender of most of the customers?
SELECT gender, count(*) cnt
FROM walmart_sales
GROUP BY gender
ORDER BY cnt desc
;

-- What is the gender distribution per branch?
SELECT gender, count(*) cnt
FROM walmart_sales
WHERE branch = 'C'
GROUP BY gender
ORDER BY cnt desc
;

-- Which time of the day do customers give most ratings?
SELECT time_of_day, AVG(Rating) avg_ratings
FROM walmart_sales
-- WHERE Branch = 'C'
GROUP BY time_of_day
ORDER BY avg_ratings desc
;

-- Which day of the week has the best avg ratings?
SELECT day_time, AVG(Rating) avg_ratings
FROM walmart_sales
GROUP BY day_time
ORDER BY avg_ratings desc
;
