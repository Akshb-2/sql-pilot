SELECT *
FROM walmart_sales;

-- -----------------------------------------------------------------------------------------------
-- --------------------------------------FEATURE ENGINEERING--------------------------------------

-- TIME OF DATE --
SELECT time,
		(CASE
				WHEN `TIME` BETWEEN  "00:00:00" AND "12:00:00:" THEN 'Morning'
                WHEN `TIME` BETWEEN "12:00:01" AND "16:00:00" THEN 'Afternoon'
                ELSE 'Evening'
		END) time_of_day
FROM walmart_sales;

ALTER TABLE walmart_sales ADD COLUMN time_of_day VARCHAR(20);

UPDATE walmart_sales
SET time_of_day = (CASE
				WHEN `TIME` BETWEEN  "00:00:00" AND "12:00:00:" THEN 'Morning'
                WHEN `TIME` BETWEEN "12:00:01" AND "16:00:00" THEN 'Afternoon'
                ELSE 'Evening'
				END) ;
                
-- day_name --
SELECT date, dayname(STR_TO_DATE(date, '%Y-%m-%d')) day_name
FROM walmart_sales;

ALTER TABLE walmart_sales ADD column day_time varchar(12);   

UPDATE walmart_sales
SET day_time = DAYNAME(STR_TO_DATE(date, '%d-%m-%Y'));

-- month_name --
SELECT date, monthname(STR_TO_DATE(date, '%Y-%m-%d')) month_name
FROM walmart_sales;

ALTER TABLE walmart_sales ADD column month_time varchar(20);   

UPDATE walmart_sales
SET month_time = monthname(STR_TO_DATE(date, '%d-%m-%Y'));       

